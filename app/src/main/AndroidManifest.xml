<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      唯一需要的权限。普通权限（normal protection level），
      安装时自动授予，不弹权限对话框，用户无法撤销。
    -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <!--
      Android 11 (API 30) 包可见性。
      不声明的话 resolveActivity() 对系统时钟会返回 null，
      导致 App 误报「找不到系统时钟应用」。

      故意用 <intent> 而不是 <package>：
      厂商的时钟包名五花八门（com.android.deskclock / com.sec.android.app.clockpackage /
      com.miui.clock ...），按能力声明才跨厂商通用。

      故意不用 QUERY_ALL_PACKAGES：与「不收集隐私」定位冲突，且没必要。
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.SET_ALARM" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SHOW_ALARMS" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.R90Alarm">

        <!--
          targetSdk 31+ 时，带 intent-filter 的组件必须显式声明 android:exported，
          否则安装失败（INSTALL_PARSE_FAILED_MANIFEST_MALFORMED）。
          LAUNCHER 入口必须是 true。

          configChanges 里带 uiMode，让深色模式切换不重建 Activity
          （否则秒级刷新的状态会被打断）。
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>
</manifest>
