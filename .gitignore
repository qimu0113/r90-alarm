# ============================================================
# R90 闹钟 · Git 忽略规则
# ============================================================
# 目标：clone 下来即可构建，且绝不把「本机私有的东西」带进仓库。

# ---------- 本机配置（每台机器都不一样）----------
# SDK 路径只有本机有；提交上去会让别人构建直接失败
local.properties
# 签名凭据：绝对不入库
*.jks
*.keystore
keystore.properties
signing.properties

# ---------- 构建产物与缓存 ----------
.gradle/
.kotlin/
build/
*.apk
*.aab
*.ap_
*.dex
*.class
release/

# ---------- IDE ----------
.idea/
*.iml
*.ipr
*.iws
.vscode/
captures/

# ---------- 真机取证件（含拉取的系统 APK，约 100 MB）----------
# 只是本次验证的临时证据，不属于源码
_ondevice/

# ---------- 改动前的原件备份 ----------
_backup/

# ---------- 一次性脚本归档 ----------
_verify/_archive/

# ---------- 系统 ----------
.DS_Store
Thumbs.db
*.log

# 本地隐私扫描工具（内含敏感词清单，绝不入库）
_verify/脱敏扫描.sh
